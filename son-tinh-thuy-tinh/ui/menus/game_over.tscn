[gd_scene load_steps=2 format=3 uid="uid://game_over_scene"]

[ext_resource type="Script" path="res://ui/menus/game_over.gd" id="1_gameover"]

[node name="GameOver" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_gameover")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.88)

[node name="CenterContainer" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -200.0
offset_top = -160.0
offset_right = 200.0
offset_bottom = 160.0
grow_horizontal = 2
grow_vertical = 2
alignment = 1
theme_override_constants/separation = 24

[node name="SkullIcon" type="Label" parent="CenterContainer"]
layout_mode = 2
text = "💀"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 72

[node name="GameOverTitle" type="Label" parent="CenterContainer"]
layout_mode = 2
text = "GAME OVER!"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 60
theme_override_colors/font_color = Color(0.9, 0.1, 0.1, 1)
theme_override_colors/font_outline_color = Color(0.4, 0, 0, 1)
theme_override_constants/outline_size = 5

[node name="SubTitle" type="Label" parent="CenterContainer"]
layout_mode = 2
text = "Sơn Tinh đã thất bại!"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 22
theme_override_colors/font_color = Color(1, 1, 1, 0.8)

[node name="MenuButton" type="Button" parent="CenterContainer"]
layout_mode = 2
text = "  Về Menu  "
alignment = 1
theme_override_font_sizes/font_size = 22

[connection signal="pressed" from="CenterContainer/MenuButton" to="." method="_on_menu_pressed"]
